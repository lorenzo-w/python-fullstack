{
	"mcpServers": {
		"git": {
			"command": "uvx",
			"args": [
				"mcp-server-git",
				"--repository",
				"./"
			]
		},
		"memory": {
			"command": "deno",
			"args": [
				"x",
				"-y",
        "@modelcontextprotocol/server-memory"
			]
		},
		"context7": {
			"type": "streamable-http",
			"url": "https://mcp.context7.com/mcp"
		},
		"exa": {
			"type": "streamable-http",
			"url": "https://mcp.exa.ai/mcp"
		}
	}
}